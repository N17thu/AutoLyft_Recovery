{
  "name": "ServiceProvider",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "towing",
          "tire_change",
          "battery_jump",
          "fuel_delivery",
          "lockout",
          "general_repair"
        ]
      }
    },
    "location_address": {
      "type": "string"
    },
    "location_lat": {
      "type": "number"
    },
    "location_lng": {
      "type": "number"
    },
    "rating": {
      "type": "number"
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "price_range": {
      "type": "string",
      "enum": [
        "$",
        "$$",
        "$$$"
      ]
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "response_time": {
      "type": "number",
      "description": "Average response time in minutes"
    },
    "image_url": {
      "type": "string"
    },
    "service_radius": {
      "type": "number",
      "description": "Service radius in miles",
      "default": 25
    },
    "operating_hours": {
      "type": "object",
      "properties": {
        "monday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "closed": {
              "type": "boolean"
            }
          }
        },
        "tuesday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "closed": {
              "type": "boolean"
            }
          }
        },
        "wednesday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "closed": {
              "type": "boolean"
            }
          }
        },
        "thursday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "closed": {
              "type": "boolean"
            }
          }
        },
        "friday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "closed": {
              "type": "boolean"
            }
          }
        },
        "saturday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "closed": {
              "type": "boolean"
            }
          }
        },
        "sunday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "closed": {
              "type": "boolean"
            }
          }
        }
      },
      "default": {
        "monday": {
          "start": "08:00",
          "end": "18:00",
          "closed": false
        },
        "tuesday": {
          "start": "08:00",
          "end": "18:00",
          "closed": false
        },
        "wednesday": {
          "start": "08:00",
          "end": "18:00",
          "closed": false
        },
        "thursday": {
          "start": "08:00",
          "end": "18:00",
          "closed": false
        },
        "friday": {
          "start": "08:00",
          "end": "18:00",
          "closed": false
        },
        "saturday": {
          "start": "09:00",
          "end": "15:00",
          "closed": false
        },
        "sunday": {
          "start": "00:00",
          "end": "00:00",
          "closed": true
        }
      }
    },
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "plate": {
            "type": "string"
          },
          "capacity": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "name",
    "phone",
    "services"
  ]
}